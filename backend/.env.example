# GLPI API REST
GLPI_URL=http://192.168.100.249/apirest.php
GLPI_USER=CAMBIAR_USUARIO_GLPI
GLPI_PASS=CAMBIAR_CLAVE_GLPI
GLPI_APP_TOKEN=tu_app_token_aqui

# ClickUp API v2
CLICKUP_TOKEN=pk_tu_token_aqui
CLICKUP_TEAM_ID=31558859

# Base de datos: PostgreSQL (recomendado para produccion con docker compose)
DATABASE_URL=postgresql+psycopg2://tasks_user:CAMBIAR_CLAVE_SEGURA_POSTGRES@db:5432/tasks_db
# Para desarrollo local con SQLite descomentar:
# DATABASE_URL=sqlite:///./dashboard.db

SYNC_INTERVAL_MINUTES=2
AGENDA_BASE_URL=http://localhost:7070

# Seguridad Fase 1
ENABLE_API_DOCS=false
# Lista separada por comas (opcional; por defecto usa el origen de AGENDA_BASE_URL + localhost)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:7070
# Solo requerido si se siembra una BD vacia por primera vez (si se omite, genera clave aleatoria en log)
DEFAULT_INIT_PASSWORD=

# Seguridad Fase 2: Sesiones firmadas, compatibilidad HTTP (:7070) vs HTTPS y TV Kiosko
# Generar en Linux/OpenSSL: openssl rand -hex 32
AUTH_SECRET_KEY=CAMBIAR_SECRETO_HMAC_MINIMO_32_BYTES_HEX
# Mantener en false mientras el portal sirva sobre HTTP (:7070 / IP). Activar a true tras habilitar HTTPS en Fase 3
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
# Secreto dedicado para autenticacion de pantallas TV Kiosko (solo lectura)
KIOSK_SECRET=CAMBIAR_SECRETO_KIOSK_TV
# Opcional: IPs/CIDRs permitidas para modo Kiosko (ej: 192.168.100.50,10.0.0.0/8)
KIOSK_ALLOWED_IPS=
